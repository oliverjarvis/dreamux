#!/usr/bin/env python3
"""dreamux-hook — bridge a coding agent's hook events into Dreamux's
notification pipeline.

Bundled inside Dreamux.app at Resources/bin/dreamux-hook and
prepended to the spawned shell's PATH (via ZDOTDIR), so agents like
Claude Code can call it directly from their hook config — no install
step on the user's machine.

Subcommands:
  stop       — fired on assistant-turn completion. Reads the transcript
               path from stdin (Claude Code passes it as JSON) and only
               emits a notification if the last assistant message is
               substantive — i.e., not empty and not the
               "[Request interrupted by user]" placeholder. This keeps
               Ctrl+C-style cancellations silent.
  notify     — fired when the agent wants user attention. Uses arg 2 if
               given, else $CLAUDE_NOTIFICATION_MESSAGE, else a default.
  idle       — explicit "agent is waiting" hook variant.
  <free text> — emits the joined args as the notification body.

The actual transport is OSC 9 (ESC ] 9 ; <body> BEL), preferring
/dev/tty over stdout because agents commonly capture hook stdout for
their own UI which would otherwise eat the sequence. Dreamux's PTY
parser pulls the body out and routes it to the right tab.
"""

from __future__ import annotations

import json
import os
import sys
import time
from typing import Any, Optional, Tuple


# When DREAMUX_HOOK_DEBUG=1 is set in the agent's env, every hook
# invocation appends a line to this log so we can see whether Stop fired,
# what stdin payload Claude Code sent, why a stop-handler returned early,
# and whether emit() actually wrote the OSC. Off by default — set the env
# var only when diagnosing.
DEBUG_LOG_PATH = os.path.expanduser("~/Library/Logs/Dreamux-hook.log")


def log(event: str, **fields: Any) -> None:
    if os.environ.get("DREAMUX_HOOK_DEBUG") != "1":
        return
    try:
        os.makedirs(os.path.dirname(DEBUG_LOG_PATH), exist_ok=True)
        with open(DEBUG_LOG_PATH, "a", encoding="utf-8") as f:
            payload = {"t": time.strftime("%H:%M:%S"), "event": event, **fields}
            f.write(json.dumps(payload, default=str) + "\n")
    except Exception:
        pass


def _session_tty_path() -> Optional[str]:
    """The session terminal's device path, for when this process has no
    controlling terminal of its own. Claude Code ≥2.1.206 runs hook
    subprocesses detached from the tty (`open('/dev/tty')` → ENXIO),
    but the parent claude still sits on the session PTY — resolve its
    tty device via ps. Writing to the slave device reaches Dreamux's
    master-side reader exactly like /dev/tty used to."""
    import subprocess

    try:
        name = subprocess.check_output(
            ["ps", "-o", "tty=", "-p", str(os.getppid())],
            text=True, timeout=2.0,
        ).strip()
    except Exception as exc:
        log("tty_resolve_fail", ppid=os.getppid(), error=str(exc))
        return None
    if not name or name in ("??", "-"):
        log("tty_resolve_fail", ppid=os.getppid(), error=f"ps says {name!r}")
        return None
    return "/dev/" + name


def _write_osc(seq: str, event: str, **fields) -> None:
    """Deliver an escape sequence to the session's terminal: the hook's
    own /dev/tty when it has one (claude ≤2.1.205), the parent claude's
    tty device otherwise (≥2.1.206 detaches hooks from the terminal),
    stdout as the last resort (only right when stdout IS a terminal,
    e.g. invoked outside claude)."""
    candidates = ["/dev/tty"]
    resolved = _session_tty_path()
    if resolved:
        candidates.append(resolved)
    for path in candidates:
        try:
            with open(path, "w") as tty:
                tty.write(seq)
                tty.flush()
                log(event, channel=path, **fields)
                return
        except OSError as exc:
            log(f"{event}_tty_fail", channel=path, error=str(exc))
    sys.stdout.write(seq)
    sys.stdout.flush()
    log(event, channel="stdout", **fields)


def emit(message: str) -> None:
    """Write `OSC 9 ; message BEL` to the session terminal so it
    reaches Dreamux's PTY parser even when the agent has captured
    stdout."""
    _write_osc(f"\033]9;{message}\a", "emit", message=message)


def control_emit(verb: str, payload: dict) -> None:
    """Emit a Dreamux control OSC: a structured event Dreamux's PTY
    parser routes to the owning tab (session binding, chat-face state).
    Same transport rationale as emit(); base64url keeps the body free
    of semicolons and terminators so the Swift-side splitter can't
    clip it. OSC 777 subcommand `dreamux` — unknown to terminals,
    invisible if it ever leaks to a real one."""
    import base64

    body = base64.urlsafe_b64encode(
        json.dumps(payload, separators=(",", ":")).encode("utf-8")
    ).decode("ascii")
    _write_osc(f"\033]777;dreamux;{verb};{body}\a", "control_emit", verb=verb)


def read_stdin_json() -> Optional[dict]:
    if sys.stdin.isatty():
        return None
    try:
        raw = sys.stdin.read()
    except Exception:
        return None
    if not raw.strip():
        return None
    try:
        parsed = json.loads(raw)
    except Exception:
        return None
    if not isinstance(parsed, dict):
        # Every caller treats the result as a dict (.get(...) chains in
        # flow_handler/notify_handler/emit_signal); a top-level JSON
        # array/string/number would otherwise raise AttributeError and
        # crash the hook. Guarded centrally so every handler stays silent.
        log("stdin_skip", reason="not_a_dict", type=type(parsed).__name__)
        return None
    return parsed


# ---------------------------------------------------------------------------
# Signal sink — mirror hook lifecycle events onto Dreamux's signal bus.
#
# Transport: one JSON line to the Unix socket in $DREAMUX_EMIT_SOCKET
# (set by Dreamux's PTY sessions; absent outside Dreamux → no-op).
# Failures are ALWAYS silent (log-only): a hook must never break or
# slow the user's claude session.
# ---------------------------------------------------------------------------

# Fields copied verbatim from the hook's stdin JSON into the signal
# payload. Whitelist, not passthrough: hook payloads can contain large
# prompts/transcript excerpts we don't want in signals.db.
PAYLOAD_FIELDS = (
    "session_id",
    "agent_id",
    "agent_type",
    "description",
    "task_id",
    "subject",
    "message",
    "hook_event_name",
)

HOOK_EVENT_KINDS = {
    "SubagentStart": "agent.started",
    "SubagentStop": "agent.stopped",
    "TaskCreated": "task.created",
    "TaskCompleted": "task.completed",
    # SessionEnd is Claude Code's true once-per-session terminal hook
    # (unlike Stop, which fires at the end of every assistant turn) —
    # session.stopped rides this one so FlowStore only ever sees it at
    # actual session end.
    "SessionEnd": "session.stopped",
}


def emit_signal(kind: str, stdin_payload: Optional[dict], message: Optional[str] = None) -> None:
    sock_path = os.environ.get("DREAMUX_EMIT_SOCKET", "")
    if not sock_path:
        log("signal_skip", reason="no_socket_env", kind=kind)
        return
    payload: dict = {}
    if stdin_payload:
        for field in PAYLOAD_FIELDS:
            value = stdin_payload.get(field)
            if isinstance(value, str) and value:
                payload[field] = value
    if message and "message" not in payload:
        payload["message"] = message
    if not payload.get("session_id"):
        log("signal_skip", reason="no_session_id", kind=kind)
        return
    cwd = ""
    if stdin_payload and isinstance(stdin_payload.get("cwd"), str):
        cwd = stdin_payload["cwd"]
    envelope = {
        "action": "emit",
        "signal": {
            "kind": kind,
            "source": "claude.hooks",
            "severity": "info",
            "tags": {"cwd": cwd},
            "payload": payload,
        },
    }
    try:
        import socket as socketlib

        s = socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM)
        s.settimeout(0.5)
        try:
            s.connect(sock_path)
            s.sendall((json.dumps(envelope) + "\n").encode("utf-8"))
            try:
                s.recv(256)  # ack; best-effort
            except Exception:
                pass
        finally:
            s.close()
        log("signal_sent", kind=kind)
    except Exception as exc:
        log("signal_fail", kind=kind, error=str(exc))


def flow_handler() -> None:
    """`dreamux-hook flow` — generic lifecycle relay. The event name
    comes from stdin's hook_event_name, so one settings entry covers
    all five lifecycle hooks."""
    payload = read_stdin_json()
    log(
        "flow_in",
        payload_keys=list(payload.keys()) if payload else None,
        hook_event_name=payload.get("hook_event_name") if payload else None,
    )
    if not payload:
        log("flow_skip", reason="no_stdin_json")
        return
    event = payload.get("hook_event_name") or ""
    kind = HOOK_EVENT_KINDS.get(event)
    if not kind:
        log("flow_skip", reason="unknown_event", hook_event_name=event)
        return
    emit_signal(kind, payload)
    if event == "SessionEnd":
        control_emit("session-end", {"session_id": payload.get("session_id") or ""})


def session_start_handler() -> None:
    """`dreamux-hook session-start` — announce a new/resumed/cleared
    session to the owning Dreamux tab. claude_pid = our parent (the
    hook runs as claude's child), which names the session's registry
    file ~/.claude/sessions/<pid>.json."""
    payload = read_stdin_json()
    if not payload:
        log("session_start_skip", reason="no_stdin_json")
        return
    control_emit("session-start", {
        "session_id": payload.get("session_id") or "",
        "transcript_path": payload.get("transcript_path") or "",
        "cwd": payload.get("cwd") or "",
        "source": payload.get("source") or "",
        "claude_pid": os.getppid(),
    })


def scan_transcript(
    transcript_path: str,
) -> Tuple[int, Optional[dict], int]:
    """Walk the JSONL transcript and return (last_user_idx,
    last_assistant_entry, last_assistant_idx). Indices are -1 if the
    corresponding entry doesn't exist; the assistant entry is None when
    the transcript has no assistant turns."""
    last_user_idx = -1
    last_assistant_idx = -1
    last_assistant: Optional[dict] = None
    try:
        with open(transcript_path, encoding="utf-8") as f:
            for i, line in enumerate(f):
                try:
                    entry = json.loads(line)
                except Exception:
                    continue
                kind = entry.get("type")
                if kind == "user":
                    last_user_idx = i
                elif kind == "assistant":
                    last_assistant_idx = i
                    last_assistant = entry
    except Exception:
        pass
    return last_user_idx, last_assistant, last_assistant_idx


def extract_text(entry: dict) -> str:
    """Pull the text out of an assistant transcript entry — Claude Code
    uses a list of `{type, text}` content blocks; fall back to a plain
    string for older or simpler shapes."""
    msg = entry.get("message", entry)
    content = msg.get("content", "")
    if isinstance(content, list):
        parts = []
        for block in content:
            if isinstance(block, dict):
                if block.get("type") == "text":
                    parts.append(block.get("text") or "")
                elif "text" in block and isinstance(block["text"], str):
                    parts.append(block["text"])
        text = "\n".join(p for p in parts if p)
    elif isinstance(content, str):
        text = content
    else:
        text = ""
    return text.strip()


def stop_handler() -> None:
    payload = read_stdin_json()
    log("stop_in", payload_keys=list(payload.keys()) if payload else None)
    if payload is None:
        # No JSON input — be conservative and skip rather than spamming.
        log("stop_skip", reason="no_stdin_json")
        return
    control_emit("stop", {"session_id": payload.get("session_id") or ""})

    # Note: session.stopped is emitted from the SessionEnd hook (see
    # flow_handler / HOOK_EVENT_KINDS), not here — Stop fires at the end
    # of every assistant turn, not just at session end, so emitting the
    # signal here would mark every lane permanently done on each turn.

    transcript_path = payload.get("transcript_path") or ""
    if not transcript_path or not os.path.exists(transcript_path):
        log("stop_skip", reason="no_transcript", path=transcript_path)
        return

    # Poll the transcript until the just-completed assistant turn lands.
    # Claude Code's Stop hook can fire before the turn is flushed to
    # disk, which is why we'd otherwise emit the *previous* turn's text
    # (or nothing at all on the first response).
    #
    # The signal that the turn has flushed: the file ends with an
    # assistant entry that comes AFTER the most recent user entry. While
    # the file ends with a user entry (or nothing), we keep polling.
    deadline = time.monotonic() + 3.0
    assistant_entry: Optional[dict] = None
    while True:
        user_idx, candidate, candidate_idx = scan_transcript(transcript_path)
        if candidate is not None and candidate_idx > user_idx:
            assistant_entry = candidate
            break
        if time.monotonic() >= deadline:
            break
        time.sleep(0.05)

    if assistant_entry is None:
        # Timed out without a fresh assistant entry — likely an
        # interrupt or a session that ended without a new response.
        log("stop_skip", reason="poll_timeout")
        return

    text = extract_text(assistant_entry)
    if not text:
        log("stop_skip", reason="empty_text")
        return

    lowered = text.lower()
    interrupt_markers = (
        "[request interrupted by user]",
        "[interrupted by user]",
    )
    if any(marker in lowered for marker in interrupt_markers):
        log("stop_skip", reason="interrupted")
        return

    if len(text) > 200:
        text = text[:200].rstrip() + "…"
    text = " ".join(text.split())
    if not text:
        return

    emit(text)


def notify_handler() -> None:
    payload = read_stdin_json()
    message = None
    if payload and isinstance(payload.get("message"), str):
        message = payload["message"]
    if not message:
        message = (
            sys.argv[2]
            if len(sys.argv) > 2
            else os.environ.get("CLAUDE_NOTIFICATION_MESSAGE", "Agent is waiting on you")
        )
    if payload:
        emit_signal("session.notification", payload, message=message)
    if not message:
        return
    control_emit("notify", {
        "message": message or "",
        "session_id": (payload or {}).get("session_id") or "",
        "cwd": (payload or {}).get("cwd") or "",
    })
    emit(message)


def idle_handler() -> None:
    message = sys.argv[2] if len(sys.argv) > 2 else "Agent is waiting on you"
    emit(message)


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    log("invoke", cmd=cmd, argv=sys.argv[1:])
    if cmd == "stop":
        stop_handler()
    elif cmd == "notify":
        notify_handler()
    elif cmd == "idle":
        idle_handler()
    elif cmd == "flow":
        flow_handler()
    elif cmd == "session-start":
        session_start_handler()
    elif cmd:
        emit(" ".join(sys.argv[1:]))
    else:
        emit("Agent activity")


if __name__ == "__main__":
    main()
