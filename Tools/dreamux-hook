#!/usr/bin/env python3
"""dreamux-hook — bridge a coding agent's hook events into Dreamux's
notification pipeline.

Bundled inside Dreamux.app at Resources/bin/dreamux-hook and
prepended to the spawned shell's PATH (via ZDOTDIR), so agents like
Claude Code can call it directly from their hook config — no install
step on the user's machine.

Subcommands:
  event      — `--harness <id>`; the one normalizer. Maps a harness's
               hook payload to an attention state via harnesses.json and
               emits it as an `agent-state` control OSC, plus the legacy
               stop/notify verbs the chat-face binding reads.
  statusline — Claude Code's statusLine command. A transparent tap: it
               posts the payload's rate_limits to Dreamux, then runs the
               user's OWN statusline (from ~/.claude/settings.json) and
               echoes its stdout verbatim. Prints nothing of its own —
               stdout is the statusline's render channel.
  notify     — fired when the agent wants user attention. Uses arg 2 if
               given, else $CLAUDE_NOTIFICATION_MESSAGE, else a default.
  idle       — explicit "agent is waiting" hook variant.
  <free text> — emits the joined args as the notification body.

The actual transport is OSC 9 (ESC ] 9 ; <body> BEL), preferring
/dev/tty over stdout because agents commonly capture hook stdout for
their own UI which would otherwise eat the sequence. Dreamux's PTY
parser pulls the body out and routes it to the right tab.
"""

from __future__ import annotations

import json
import os
import sys
import time
from typing import Any, Optional


# When DREAMUX_HOOK_DEBUG=1 is set in the agent's env, every hook
# invocation appends a line to this log so we can see whether Stop fired,
# what stdin payload Claude Code sent, why a stop-handler returned early,
# and whether emit() actually wrote the OSC. Off by default — set the env
# var only when diagnosing.
DEBUG_LOG_PATH = os.path.expanduser("~/Library/Logs/Dreamux-hook.log")


def log(event: str, **fields: Any) -> None:
    if os.environ.get("DREAMUX_HOOK_DEBUG") != "1":
        return
    try:
        os.makedirs(os.path.dirname(DEBUG_LOG_PATH), exist_ok=True)
        with open(DEBUG_LOG_PATH, "a", encoding="utf-8") as f:
            payload = {"t": time.strftime("%H:%M:%S"), "event": event, **fields}
            f.write(json.dumps(payload, default=str) + "\n")
    except Exception:
        pass


def _session_tty_path() -> Optional[str]:
    """The session terminal's device path, for when this process has no
    controlling terminal of its own. Claude Code ≥2.1.206 runs hook
    subprocesses detached from the tty (`open('/dev/tty')` → ENXIO),
    but the parent claude still sits on the session PTY — resolve its
    tty device via ps. Writing to the slave device reaches Dreamux's
    master-side reader exactly like /dev/tty used to."""
    import subprocess

    try:
        name = subprocess.check_output(
            ["ps", "-o", "tty=", "-p", str(os.getppid())],
            text=True, timeout=2.0,
        ).strip()
    except Exception as exc:
        log("tty_resolve_fail", ppid=os.getppid(), error=str(exc))
        return None
    if not name or name in ("??", "-"):
        log("tty_resolve_fail", ppid=os.getppid(), error=f"ps says {name!r}")
        return None
    return "/dev/" + name


def _write_osc(seq: str, event: str, **fields) -> None:
    """Deliver an escape sequence to the session's terminal: the hook's
    own /dev/tty when it has one (claude ≤2.1.205), the parent claude's
    tty device otherwise (≥2.1.206 detaches hooks from the terminal),
    stdout as the last resort (only right when stdout IS a terminal,
    e.g. invoked outside claude)."""
    candidates = ["/dev/tty"]
    resolved = _session_tty_path()
    if resolved:
        candidates.append(resolved)
    for path in candidates:
        try:
            with open(path, "w") as tty:
                tty.write(seq)
                tty.flush()
                log(event, channel=path, **fields)
                return
        except OSError as exc:
            log(f"{event}_tty_fail", channel=path, error=str(exc))
    sys.stdout.write(seq)
    sys.stdout.flush()
    log(event, channel="stdout", **fields)


def emit(message: str) -> None:
    """Write `OSC 9 ; message BEL` to the session terminal so it
    reaches Dreamux's PTY parser even when the agent has captured
    stdout."""
    _write_osc(f"\033]9;{message}\a", "emit", message=message)


def control_emit(verb: str, payload: dict) -> None:
    """Emit a Dreamux control OSC: a structured event Dreamux's PTY
    parser routes to the owning tab (session binding, chat-face state).
    Same transport rationale as emit(); base64url keeps the body free
    of semicolons and terminators so the Swift-side splitter can't
    clip it. OSC 777 subcommand `dreamux` — unknown to terminals,
    invisible if it ever leaks to a real one."""
    import base64

    body = base64.urlsafe_b64encode(
        json.dumps(payload, separators=(",", ":")).encode("utf-8")
    ).decode("ascii")
    _write_osc(f"\033]777;dreamux;{verb};{body}\a", "control_emit", verb=verb)


def read_stdin_json() -> Optional[dict]:
    if sys.stdin.isatty():
        return None
    try:
        raw = sys.stdin.read()
    except Exception:
        return None
    if not raw.strip():
        return None
    try:
        parsed = json.loads(raw)
    except Exception:
        return None
    if not isinstance(parsed, dict):
        # Every caller treats the result as a dict (.get(...) chains in
        # flow_handler/notify_handler/emit_signal); a top-level JSON
        # array/string/number would otherwise raise AttributeError and
        # crash the hook. Guarded centrally so every handler stays silent.
        log("stdin_skip", reason="not_a_dict", type=type(parsed).__name__)
        return None
    return parsed


# ---------------------------------------------------------------------------
# Signal sink — mirror hook lifecycle events onto Dreamux's signal bus.
#
# Transport: one JSON line to the Unix socket in $DREAMUX_EMIT_SOCKET
# (set by Dreamux's PTY sessions; absent outside Dreamux → no-op).
# Failures are ALWAYS silent (log-only): a hook must never break or
# slow the user's claude session.
# ---------------------------------------------------------------------------

# Fields copied verbatim from the hook's stdin JSON into the signal
# payload. Whitelist, not passthrough: hook payloads can contain large
# prompts/transcript excerpts we don't want in signals.db.
PAYLOAD_FIELDS = (
    "session_id",
    "agent_id",
    "agent_type",
    "description",
    "task_id",
    "subject",
    "message",
    "hook_event_name",
)

HOOK_EVENT_KINDS = {
    "SubagentStart": "agent.started",
    "SubagentStop": "agent.stopped",
    "TaskCreated": "task.created",
    "TaskCompleted": "task.completed",
    # SessionEnd is Claude Code's true once-per-session terminal hook
    # (unlike Stop, which fires at the end of every assistant turn) —
    # session.stopped rides this one so FlowStore only ever sees it at
    # actual session end.
    "SessionEnd": "session.stopped",
}


# ---------------------------------------------------------------------------
# Harness catalog — the event → attention-state table shared with Swift.
#
# Lives beside this script (Tools/ in a checkout, Contents/Resources/bin/
# in the bundle) so one rule resolves it in both layouts.
# DREAMUX_HARNESSES_JSON overrides, for tests.
# ---------------------------------------------------------------------------

CLAUDE_FALLBACK_EVENTS = {
    "Notification:permission_prompt": {"state": "blocked", "reason": "permission"},
    "Notification:idle_prompt": {"state": "blocked", "reason": "question"},
    "Notification:agent_needs_input": {"state": "blocked", "reason": "subagentInput"},
    "Notification:elicitation_dialog": {"state": "blocked", "reason": "elicitation"},
    "Notification:agent_completed": {"state": "done"},
    "PermissionRequest": {"state": "blocked", "reason": "permission"},
    "Stop": {"state": "done", "messageField": "last_assistant_message"},
    "UserPromptSubmit": {"state": "working"},
    "PreToolUse": {"state": "working"},
    "SessionEnd": {"state": "none"},
}


def _catalog_path() -> str:
    override = os.environ.get("DREAMUX_HARNESSES_JSON", "")
    if override:
        return override
    return os.path.join(os.path.dirname(os.path.abspath(__file__)), "harnesses.json")


def load_events(harness: str) -> Optional[dict]:
    """Event table for one harness. A missing or corrupt catalog degrades
    to the compiled-in Claude table rather than to silence — but an
    unknown harness is still unknown, and returns None."""
    try:
        with open(_catalog_path(), encoding="utf-8") as f:
            catalog = json.load(f)
        for entry in catalog.get("harnesses") or []:
            if entry.get("id") == harness:
                events = entry.get("events")
                if isinstance(events, dict) and events:
                    return events
        log("catalog_no_harness", harness=harness)
        return CLAUDE_FALLBACK_EVENTS if harness == "claude" else None
    except Exception as exc:
        log("catalog_fail", error=str(exc))
        return CLAUDE_FALLBACK_EVENTS if harness == "claude" else None


INTERRUPT_MARKERS = (
    "[request interrupted by user]",
    "[interrupted by user]",
)


def clip(text: Optional[str]) -> str:
    """One line, at most 200 characters plus an ellipsis — a banner body,
    not a transcript."""
    if not text:
        return ""
    collapsed = " ".join(text.split())
    if len(collapsed) > 200:
        return collapsed[:200].rstrip() + "…"
    return collapsed


def send_socket_line(envelope: dict, what: str) -> None:
    """One newline-delimited JSON line to $DREAMUX_EMIT_SOCKET. The
    transport both the signal sink and the statusline tap use. ALWAYS
    silent on failure (log-only): a hook must never break or slow the
    user's claude session."""
    sock_path = os.environ.get("DREAMUX_EMIT_SOCKET", "")
    if not sock_path:
        log("socket_skip", reason="no_socket_env", what=what)
        return
    try:
        import socket as socketlib

        s = socketlib.socket(socketlib.AF_UNIX, socketlib.SOCK_STREAM)
        s.settimeout(0.5)
        try:
            s.connect(sock_path)
            s.sendall((json.dumps(envelope) + "\n").encode("utf-8"))
            try:
                s.recv(256)  # ack; best-effort
            except Exception:
                pass
        finally:
            s.close()
        log("socket_sent", what=what)
    except Exception as exc:
        log("socket_fail", what=what, error=str(exc))


def emit_signal(kind: str, stdin_payload: Optional[dict], message: Optional[str] = None) -> None:
    payload: dict = {}
    if stdin_payload:
        for field in PAYLOAD_FIELDS:
            value = stdin_payload.get(field)
            if isinstance(value, str) and value:
                payload[field] = value
    if message and "message" not in payload:
        payload["message"] = message
    if not payload.get("session_id"):
        log("signal_skip", reason="no_session_id", kind=kind)
        return
    cwd = ""
    if stdin_payload and isinstance(stdin_payload.get("cwd"), str):
        cwd = stdin_payload["cwd"]
    envelope = {
        "action": "emit",
        "signal": {
            "kind": kind,
            "source": "claude.hooks",
            "severity": "info",
            "tags": {"cwd": cwd},
            "payload": payload,
        },
    }
    send_socket_line(envelope, what=kind)


def flow_handler() -> None:
    """`dreamux-hook flow` — generic lifecycle relay. The event name
    comes from stdin's hook_event_name, so one settings entry covers
    all five lifecycle hooks."""
    payload = read_stdin_json()
    log(
        "flow_in",
        payload_keys=list(payload.keys()) if payload else None,
        hook_event_name=payload.get("hook_event_name") if payload else None,
    )
    if not payload:
        log("flow_skip", reason="no_stdin_json")
        return
    event = payload.get("hook_event_name") or ""
    kind = HOOK_EVENT_KINDS.get(event)
    if not kind:
        log("flow_skip", reason="unknown_event", hook_event_name=event)
        return
    emit_signal(kind, payload)
    if event == "SessionEnd":
        control_emit("session-end", {"session_id": payload.get("session_id") or ""})


def session_start_handler() -> None:
    """`dreamux-hook session-start` — announce a new/resumed/cleared
    session to the owning Dreamux tab. claude_pid = our parent (the
    hook runs as claude's child), which names the session's registry
    file ~/.claude/sessions/<pid>.json."""
    payload = read_stdin_json()
    if not payload:
        log("session_start_skip", reason="no_stdin_json")
        return
    control_emit("session-start", {
        "session_id": payload.get("session_id") or "",
        "transcript_path": payload.get("transcript_path") or "",
        "cwd": payload.get("cwd") or "",
        "source": payload.get("source") or "",
        "claude_pid": os.getppid(),
    })


def _flag_value(name: str) -> Optional[str]:
    argv = sys.argv[1:]
    for i, arg in enumerate(argv):
        if arg == name and i + 1 < len(argv):
            return argv[i + 1]
        if arg.startswith(name + "="):
            return arg.split("=", 1)[1]
    return None


def event_handler() -> None:
    """`dreamux-hook event --harness <id>` — the one normalizer.

    Turns any harness's hook payload into a single `agent-state` control
    OSC using the shared catalog, so Swift never learns a harness's
    native vocabulary. Also re-emits the legacy `stop` / `notify` verbs
    ClaudeSessionBinding consumes, so the chat face keeps working."""
    harness = _flag_value("--harness") or "claude"
    payload = read_stdin_json() or {}
    events = load_events(harness)
    if not events:
        log("event_skip", reason="unknown_harness", harness=harness)
        return

    hook = payload.get("hook_event_name") or ""
    discriminator = payload.get("notification_type") or ""
    transition = None
    if discriminator:
        transition = events.get("%s:%s" % (hook, discriminator))
    if transition is None:
        transition = events.get(hook)
    if not isinstance(transition, dict) or not transition.get("state"):
        log("event_skip", reason="unmapped", harness=harness,
            hook=hook, discriminator=discriminator)
        return

    field = transition.get("messageField") or "message"
    raw = payload.get(field)
    if not isinstance(raw, str):
        raw = payload.get("message") if isinstance(payload.get("message"), str) else ""

    state = transition["state"]
    if state == "done" and raw:
        lowered = raw.lower()
        if any(marker in lowered for marker in INTERRUPT_MARKERS):
            # Ctrl+C is not a completed turn. Stay silent.
            log("event_skip", reason="interrupted")
            return

    session_id = payload.get("session_id") or ""
    body = {
        "harness": harness,
        "state": state,
        "reason": transition.get("reason") or "",
        "message": clip(raw),
        "tool": payload.get("tool_name") or "",
        "request_id": payload.get("tool_use_id") or "",
        "session_id": session_id,
    }
    control_emit("agent-state", body)
    emit_signal("agent.attention", payload, message=body["message"] or None)

    # Legacy verbs the chat-face binding still reads. Kept here rather
    # than as a second hook entry so one hook invocation stays one
    # invocation.
    if state == "done":
        control_emit("stop", {"session_id": session_id})
    elif state == "blocked":
        control_emit("notify", {
            "message": body["message"],
            "session_id": session_id,
            "cwd": payload.get("cwd") or "",
        })


# ---------------------------------------------------------------------------
# Statusline tap — Claude Code's subscription quota, without typing /usage.
#
# `statusLine` is a SINGLE object in settings, not a merged list like
# `hooks`: the highest-precedence source wins outright, so Dreamux's
# --settings entry DISPLACES whatever statusline the user configured.
# This subcommand is therefore a transparent tap, not a replacement —
# it posts the quota figures, then runs the user's own command and
# echoes its stdout verbatim. Print NOTHING else on stdout.
# ---------------------------------------------------------------------------

# How long the user's statusline gets before we give up on it. A wedged
# command must not stall the agent's render loop.
USER_STATUSLINE_TIMEOUT = 2.0


def _settings_path() -> str:
    """The user's Claude Code settings. DREAMUX_CLAUDE_SETTINGS
    overrides, for tests — same shape as DREAMUX_HARNESSES_JSON."""
    override = os.environ.get("DREAMUX_CLAUDE_SETTINGS", "")
    if override:
        return override
    return os.path.expanduser("~/.claude/settings.json")


def _usage_cache_path(session_id: str) -> str:
    """Where this session's last-posted figures are remembered, so a
    stream of re-renders collapses into one post per actual change."""
    import hashlib

    digest = hashlib.sha256(session_id.encode("utf-8")).hexdigest()[:16]
    tmp = os.environ.get("TMPDIR") or "/tmp"
    return os.path.join(tmp, "dreamux-statusline-%s.json" % digest)


def _number(value: Any) -> Optional[float]:
    """A JSON number, or None. Bools are ints in Python — reject them."""
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return None
    return float(value)


def post_usage(payload: dict) -> None:
    """Post the payload's rate_limits to Dreamux, unless they're absent,
    unusable, or identical to what we last posted for this session."""
    limits = payload.get("rate_limits")
    if not isinstance(limits, dict):
        # Absent for API-key users, non-subscribers, and any session
        # before its first API response. Nothing to say.
        log("usage_skip", reason="no_rate_limits")
        return

    usage: dict = {}
    for key in ("five_hour", "seven_day"):
        window = limits.get(key)
        if not isinstance(window, dict):
            continue
        used = _number(window.get("used_percentage"))
        resets = _number(window.get("resets_at"))
        if used is None or resets is None:
            # A half-parsed window is ABSENT, not zero.
            continue
        usage[key] = {"used_percentage": used, "resets_at": int(resets)}
    if not usage:
        log("usage_skip", reason="no_usable_window")
        return

    session_id = payload.get("session_id") or ""
    fingerprint = json.dumps(usage, sort_keys=True)
    cache = _usage_cache_path(session_id)
    try:
        with open(cache, encoding="utf-8") as f:
            if f.read() == fingerprint:
                log("usage_skip", reason="unchanged")
                return
    except Exception:
        pass  # No cache, or unreadable — treat as changed.

    usage["observed_at"] = int(time.time())
    send_socket_line({"action": "usage", "usage": usage}, what="usage")
    try:
        with open(cache, "w", encoding="utf-8") as f:
            f.write(fingerprint)
    except Exception as exc:
        log("usage_cache_fail", error=str(exc))


def _user_statusline_command() -> Optional[str]:
    """The statusline command the user configured for themselves, which
    ours displaced."""
    try:
        with open(_settings_path(), encoding="utf-8") as f:
            settings = json.load(f)
    except Exception as exc:
        log("statusline_settings_miss", error=str(exc))
        return None
    if not isinstance(settings, dict):
        return None
    entry = settings.get("statusLine")
    if not isinstance(entry, dict):
        return None
    command = entry.get("command")
    if isinstance(command, str) and command.strip():
        return command
    return None


def delegate_statusline(raw: str) -> None:
    """Run the user's own statusline with the same stdin and echo its
    stdout verbatim. Bounded timeout; non-zero exit swallowed; output
    dropped on any failure. A broken user statusline costs the
    statusline, never the reading — which was already posted."""
    command = _user_statusline_command()
    if not command:
        return
    import subprocess

    try:
        result = subprocess.run(
            ["/bin/sh", "-c", command],
            input=raw,
            text=True,
            capture_output=True,
            timeout=USER_STATUSLINE_TIMEOUT,
        )
    except Exception as exc:
        log("statusline_delegate_fail", error=str(exc))
        return
    if result.returncode != 0:
        log("statusline_delegate_nonzero", code=result.returncode)
        return
    sys.stdout.write(result.stdout)


def statusline_handler() -> None:
    """`dreamux-hook statusline` — read stdin once, post the quota,
    render the user's own statusline. Always exits 0."""
    raw = ""
    if not sys.stdin.isatty():
        try:
            raw = sys.stdin.read()
        except Exception as exc:
            log("statusline_stdin_fail", error=str(exc))
            raw = ""

    payload = None
    if raw.strip():
        try:
            parsed = json.loads(raw)
            if isinstance(parsed, dict):
                payload = parsed
            else:
                log("statusline_skip", reason="not_a_dict")
        except Exception:
            log("statusline_skip", reason="not_json")

    if payload:
        try:
            post_usage(payload)
        except Exception as exc:
            log("usage_fail", error=str(exc))

    delegate_statusline(raw)


def notify_handler() -> None:
    payload = read_stdin_json()
    message = None
    if payload and isinstance(payload.get("message"), str):
        message = payload["message"]
    if not message:
        message = (
            sys.argv[2]
            if len(sys.argv) > 2
            else os.environ.get("CLAUDE_NOTIFICATION_MESSAGE", "Agent is waiting on you")
        )
    if payload:
        emit_signal("session.notification", payload, message=message)
    if not message:
        return
    control_emit("notify", {
        "message": message or "",
        "session_id": (payload or {}).get("session_id") or "",
        "cwd": (payload or {}).get("cwd") or "",
    })
    emit(message)


def idle_handler() -> None:
    message = sys.argv[2] if len(sys.argv) > 2 else "Agent is waiting on you"
    emit(message)


def main() -> None:
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    log("invoke", cmd=cmd, argv=sys.argv[1:])
    if cmd == "notify":
        notify_handler()
    elif cmd == "idle":
        idle_handler()
    elif cmd == "flow":
        flow_handler()
    elif cmd == "session-start":
        session_start_handler()
    elif cmd == "event":
        event_handler()
    elif cmd == "statusline":
        statusline_handler()
    elif cmd:
        emit(" ".join(sys.argv[1:]))
    else:
        emit("Agent activity")


if __name__ == "__main__":
    main()
