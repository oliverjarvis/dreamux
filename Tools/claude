#!/bin/sh
# claude — Dreamux's PATH shim. Bundled at
# Dreamux.app/Contents/Resources/bin/ and prepended to spawned shells'
# PATH, so typing `claude` in a Dreamux tab hits us first instead of
# the real binary.
#
# Each invocation we:
#   1. Resolve the real `claude` (walking PATH, skipping our own dir).
#   2. Build an inline `--settings` JSON pointing Stop/Notification
#      hooks at `dreamux-hook` (the sibling script).
#   3. exec the real claude with --settings <json> "$@".
#
# Result: notifications work in any Dreamux tab without writing a
# single byte to ~/.claude/settings.json or any project's .claude/.
# Outside Dreamux, vanilla `claude` keeps working as normal.
#
# Opt-out:
#   DREAMUX_CLAUDE_INTEGRATION=0  →  pass through unmodified.
#
# Fallbacks: any unexpected condition (real claude missing, hook script
# missing, opt-out flag set) reverts to a clean exec of real claude.

set -eu

SELF_DIR="$(cd "$(dirname "$0")" && pwd)"

# Find real claude — first match in PATH that isn't this shim.
REAL_CLAUDE=""
OLD_IFS="$IFS"
IFS=":"
for dir in $PATH; do
    [ -z "$dir" ] && continue
    [ "$dir" = "$SELF_DIR" ] && continue
    if [ -x "$dir/claude" ]; then
        REAL_CLAUDE="$dir/claude"
        break
    fi
done
IFS="$OLD_IFS"

if [ -z "$REAL_CLAUDE" ]; then
    cat >&2 <<MSG
dreamux: 'claude' isn't installed.

Install it (https://docs.anthropic.com/claude-code) and try again, e.g.:

    npm install -g @anthropic-ai/claude-code

MSG
    exit 127
fi

# Opt-out
if [ "${DREAMUX_CLAUDE_INTEGRATION:-1}" = "0" ]; then
    exec "$REAL_CLAUDE" "$@"
fi

HOOK="$SELF_DIR/dreamux-hook"
if [ ! -x "$HOOK" ]; then
    # Hook script missing → nothing to inject, pass through.
    exec "$REAL_CLAUDE" "$@"
fi

# Build inline hooks JSON.
#
# Stop/Notification/PermissionRequest/UserPromptSubmit: attention
# pipeline. All four call `dreamux-hook event --harness claude`, which
# normalizes them through harnesses.json into one agent-state control
# OSC (see dreamux-hook docstring).
# SessionStart: chat-face session binding (dreamux-hook session-start → control OSC).
# SubagentStart/SubagentStop/TaskCreated/TaskCompleted/SessionEnd: flow
# lifecycle events for the Flows observatory — `dreamux-hook flow`
# relays them to the app's signal socket. async:true so claude never
# waits on them. TaskCreated/TaskCompleted/SessionEnd take no matcher
# (hooks reference) — SessionEnd is the true once-per-session terminal
# event (unlike Stop, which fires every assistant turn).
#
# The hook path is wrapped in escaped quotes so it tolerates spaces in
# the bundle path. Single-quoted segments stay literal; "$HOOK" expands
# the path between escaped JSON quotes.
HOOK_CMD='"\"'"$HOOK"'\"'
# Attention: Stop / Notification / PermissionRequest / UserPromptSubmit
# all route through the one normalizer (`dreamux-hook event`), which
# maps them via harnesses.json and emits an `agent-state` control OSC.
# Stop and Notification stay SYNC for the same tty-resolution reason
# session-start does; PermissionRequest and UserPromptSubmit are async
# so a permission prompt is never held up by a local write.
# EVENT_CMD carries the closing JSON quote, since it is spliced into
# three different tails (two of them followed by `,"async":true`).
EVENT_CMD="$HOOK_CMD"' event --harness claude"'
SYNC_STOP='{"matcher":"","hooks":[{"type":"command","command":'"$EVENT_CMD"'}]}'
SYNC_NOTIFY='{"matcher":"","hooks":[{"type":"command","command":'"$EVENT_CMD"'}]}'
ASYNC_EVENT='{"hooks":[{"type":"command","command":'"$EVENT_CMD"',"async":true}]}'
FLOW_MATCHED='{"matcher":"","hooks":[{"type":"command","command":'"$HOOK_CMD"' flow","async":true}]}'
FLOW_PLAIN='{"hooks":[{"type":"command","command":'"$HOOK_CMD"' flow","async":true}]}'
# session-start is deliberately SYNC: the hook resolves the session's
# tty via its parent (claude ≥2.1.206 detaches hooks from /dev/tty),
# and an async hook's parentage/ordering isn't guaranteed. The hook is
# one local write — no user-visible delay.
SESSION_START='{"hooks":[{"type":"command","command":'"$HOOK_CMD"' session-start"}]}'
SETTINGS_JSON='{"hooks":{'
SETTINGS_JSON="$SETTINGS_JSON"'"Stop":['"$SYNC_STOP"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"Notification":['"$SYNC_NOTIFY"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"PermissionRequest":['"$ASYNC_EVENT"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"UserPromptSubmit":['"$ASYNC_EVENT"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"SubagentStart":['"$FLOW_MATCHED"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"SubagentStop":['"$FLOW_MATCHED"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"TaskCreated":['"$FLOW_PLAIN"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"TaskCompleted":['"$FLOW_PLAIN"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"SessionStart":['"$SESSION_START"'],'
SETTINGS_JSON="$SETTINGS_JSON"'"SessionEnd":['"$FLOW_PLAIN"']'
SETTINGS_JSON="$SETTINGS_JSON"'}}'

exec "$REAL_CLAUDE" --settings "$SETTINGS_JSON" "$@"
